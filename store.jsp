<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ru"><head><meta charset="utf-8"><title>Музыкальный магазин</title><link rel="stylesheet" href="assets/store.css"><script src="assets/store.js" defer></script></head><body><main><h1>Музыкальный магазин</h1><p>Исполнители, альбомы и композиции. Длительность указана в секундах.</p><p role="status"><c:out value="${sessionScope.message}"/></p><c:remove var="message" scope="session"/>
<section><h2>Исполнители</h2><form method="post" action="store"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="kind" value="artist"><input type="hidden" name="id" value="${editArtist.id}"><input type="hidden" name="action" value="${empty editArtist ? 'add' : 'update'}"><label>Имя<input type="text" name="name" value="<c:out value="${editArtist.name}"/>" maxlength="150" data-suggest="artist" list="artist-name-options" autocomplete="off" required><datalist id="artist-name-options"></datalist></label><button>${empty editArtist ? 'Добавить' : 'Сохранить'}</button><a href="store">Отменить редактирование</a></form><table><thead><tr><th>ID</th><th>Имя</th> <th>Действия</th></tr></thead><tbody><c:forEach var="row" items="${artists}"><tr><td>${row.id}</td><td><c:out value="${row.name}"/></td><td><a href="store?kind=artist&amp;edit=${row.id}">Изменить</a><form method="post" action="store" class="delete"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="kind" value="artist"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${row.id}"><button>Удалить</button></form></td></tr></c:forEach></tbody></table></section><section><h2>Альбомы</h2><form method="post" action="store"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="kind" value="album"><input type="hidden" name="id" value="${editAlbum.id}"><input type="hidden" name="action" value="${empty editAlbum ? 'add' : 'update'}"><label>Название<input type="text" name="title" value="<c:out value="${editAlbum.title}"/>" maxlength="150" data-suggest="album" list="album-title-options" autocomplete="off" required><datalist id="album-title-options"></datalist></label><label>Жанр<input type="text" name="genre" value="<c:out value="${editAlbum.genre}"/>" maxlength="80" data-suggest="genre" list="album-genre-options" autocomplete="off" required><datalist id="album-genre-options"></datalist></label><label>Исполнитель<select name="artistId" required><c:forEach var="option" items="${artists}"><option value="${option.id}" ${editAlbum.artist.id == option.id ? 'selected' : ''}><c:out value="${option.name}"/></option></c:forEach></select></label><button>${empty editAlbum ? 'Добавить' : 'Сохранить'}</button><a href="store">Отменить редактирование</a></form><table><thead><tr><th>ID</th><th>Название</th><th>Жанр</th><th>Исполнитель</th> <th>Действия</th></tr></thead><tbody><c:forEach var="row" items="${albums}"><tr><td>${row.id}</td><td><c:out value="${row.title}"/></td><td><c:out value="${row.genre}"/></td><td><c:out value="${row.artist.name}"/></td><td><a href="store?kind=album&amp;edit=${row.id}">Изменить</a><form method="post" action="store" class="delete"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="kind" value="album"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${row.id}"><button>Удалить</button></form></td></tr></c:forEach></tbody></table></section><section><h2>Композиции</h2><form method="post" action="store"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="kind" value="track"><input type="hidden" name="id" value="${editTrack.id}"><input type="hidden" name="action" value="${empty editTrack ? 'add' : 'update'}"><label>Название<input type="text" name="title" value="<c:out value="${editTrack.title}"/>" maxlength="150" data-suggest="track" list="track-title-options" autocomplete="off" required><datalist id="track-title-options"></datalist></label><label>Длительность в секундах<input type="number" name="duration" value="<c:out value="${editTrack.durationSeconds}"/>" min="1" max="2147483647" required></label><label>Альбом<select name="albumId" required><c:forEach var="option" items="${albums}"><option value="${option.id}" ${editTrack.album.id == option.id ? 'selected' : ''}><c:out value="${option.title}"/></option></c:forEach></select></label><button>${empty editTrack ? 'Добавить' : 'Сохранить'}</button><a href="store">Отменить редактирование</a></form><table><thead><tr><th>ID</th><th>Название</th><th>Длительность в секундах</th><th>Альбом</th> <th>Действия</th></tr></thead><tbody><c:forEach var="row" items="${tracks}"><tr><td>${row.id}</td><td><c:out value="${row.title}"/></td><td><c:out value="${row.durationSeconds}"/></td><td><c:out value="${row.album.title}"/></td><td><a href="store?kind=track&amp;edit=${row.id}">Изменить</a><form method="post" action="store" class="delete"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="kind" value="track"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${row.id}"><button>Удалить</button></form></td></tr></c:forEach></tbody></table></section><section><h2>Кратчайшие композиции альбомов с пятью и более треками</h2><table><thead><tr><th>Альбом</th><th>Композиция</th><th>Секунды</th></tr></thead><tbody><c:forEach var="r" items="${shortest}"><tr><td><c:out value="${r[0]}"/></td><td><c:out value="${r[1]}"/></td><td><c:out value="${r[2]}"/></td></tr></c:forEach></tbody></table></section><section><h2>Статистика исполнителей</h2><table><thead><tr><th>Исполнитель</th><th>Количество композиций</th><th>Общая длительность</th></tr></thead><tbody><c:forEach var="r" items="${stats}"><tr><td><c:out value="${r[0]}"/></td><td><c:out value="${r[1]}"/></td><td><c:out value="${r[2]}"/></td></tr></c:forEach></tbody></table></section></main></body></html>
